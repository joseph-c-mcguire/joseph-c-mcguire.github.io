---
import Layout from "../components/Layout.astro";
import resume from "../data/resume.json";
---
<Layout title="Projects | Joseph C. McGuire">
  <h1 class="text-2xl font-semibold">Projects</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    {resume.projects.map((p) => (
      <a href={p.link} target="_blank" class="block border rounded p-4 hover:shadow">
        <h2 class="font-semibold">{p.name}</h2>
        <p class="text-sm opacity-70">{p.description}</p>
        <p class="mt-2 text-xs opacity-60">Tech: {p.tech.join(", ")}</p>
      </a>
    ))}
  </div>
</Layout>
