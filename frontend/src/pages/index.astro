---
import Layout from "../components/Layout.astro";
---
<Layout title="Joseph C. McGuire" description="AI engineer & founder. Personal website.">
  <section class="py-12">
    <h1 class="text-4xl font-bold">Joseph C. McGuire</h1>
    <p class="mt-4 text-lg max-w-2xl">Co-founder at Cognitive Chemistry Labs. AI/ML, agents, data systems, and product acceleration.</p>
    <div class="mt-6 flex gap-4">
      <a href={Astro.site ? new URL('/experience', Astro.site).toString() : '/experience'} class="px-4 py-2 bg-slate-900 text-white rounded">Experience</a>
      <a href={Astro.site ? new URL('/projects', Astro.site).toString() : '/projects'} class="px-4 py-2 border rounded">Projects</a>
      <a href={Astro.site ? new URL('/contact', Astro.site).toString() : '/contact'} class="px-4 py-2 border rounded">Contact</a>
    </div>
  </section>
</Layout>
